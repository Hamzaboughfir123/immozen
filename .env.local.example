# URL publique du site (utilisée pour les metadata, sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.immozenmarrakech.com

# Formulaire "Confier mon bien" — lead propriétaire centralisé (immozen-leads-backend)
# Ville affichée dans le formulaire (lecture seule, jamais éditable par le visiteur)
NEXT_PUBLIC_CITY=Marrakech
# Domaine du site courant, envoyé comme source_site — le backend en déduit la
# ville de façon autoritaire (voir immozen-leads-backend/src/common/immozen-network.ts)
NEXT_PUBLIC_SITE_DOMAIN=immozenmarrakech.com
# URL de l'API centrale (la même pour les 5 sites ImmoZen)
NEXT_PUBLIC_API_URL=https://api.immozengroupe.com
